# Copiez ce fichier en .env.local et renseignez vos propres clés Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-anon-key
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# Clé Google Gemini (gratuite, sans carte bancaire) — sur https://aistudio.google.com/apikey
# Alimente l'OCR (import photo/PDF) et la génération pédagogique/assistant IA.
GEMINI_API_KEY=votre-clé-gemini
# Optionnel — modèle par défaut : gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# URL publique de l'app (liens de confirmation d'email / invitations)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret partagé pour protéger le cron d'expiration des abonnements
CRON_SECRET=changez-moi

# Emails autorisés à valider les paiements Wave côté admin (séparés par des virgules)
PLATFORM_ADMIN_EMAILS=vous@exemple.com

# Lien de paiement Wave Business (généré depuis l'app Wave Business) —
# affiché comme bouton cliquable aux enseignants/établissements.
WAVE_PAYMENT_LINK=https://pay.wave.com/m/...
# Repli si le lien n'est pas encore configuré (virement manuel affiché en texte) :
# WAVE_PAYMENT_PHONE=0500000000
# WAVE_PAYMENT_NAME=JedicliC
